# =============================================================================
# Git Attributes - USD/COP Trading System
# =============================================================================
# This file ensures consistent line endings and proper file handling
# across Windows/Linux/macOS development environments.
# =============================================================================
# Default behavior: auto-detect but prefer LF
* text=auto eol=lf
# Shell scripts - ALWAYS use LF (critical for Docker)
*.sh text eol=lf
*.bash text eol=lf
entrypoint.sh text eol=lf
# Python scripts
*.py text eol=lf
# SQL scripts
*.sql text eol=lf
# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
# Dockerfiles
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
# Binary files - DO NOT modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary
*.pkl binary
*.pickle binary
*.pth binary
*.pt binary
*.onnx binary
*.h5 binary
*.hdf5 binary
# Model files
*.zip binary
models/**/*.zip binary
seeds/*.parquet filter=lfs diff=lfs merge=lfs -text
seeds/**/*.parquet filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# News Engine historical data (Git LFS - large CSV/JSON files)
# =============================================================================
data/news/*.csv filter=lfs diff=lfs merge=lfs -text
data/news/*.json filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Weekly analysis exports (Git LFS - 300-600KB each, grows weekly)
# =============================================================================
usdcop-trading-dashboard/public/data/analysis/weekly_*.json filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Backups restore-criticos (Git LFS) — brecha detectada en la auditoria 2026-08-24
# =============================================================================
# `seeds/**/*.parquet` YA estaba en LFS (sus blobs en HEAD son punteros de ~130 B),
# pero las reglas nunca cubrieron `data/backups/`, que es donde viven los ficheros
# MAS grandes del repo y se guardaban EN CRUDO dentro del pack:
#
#   data/backups/seeds/usdcop_m5_ohlcv_backup.parquet   59,0 MB
#   data/backups/features/usdcop_m5_ohlcv.parquet       53,5 MB
#   data/backups/features/asset_native_ohlcv.parquet     8,0 MB
#   ...                                        total   129,5 MB
#
# `seeds/**/*.parquet` NO coincide con `data/backups/seeds/*.parquet`: el patron esta
# anclado a la raiz. Son el fallback de restore (CLAUDE.md los versiona a proposito) y
# rotan, asi que cada rotacion metia decenas de MB nuevos en el pack.
#
# Esto solo afecta a commits FUTUROS — los blobs ya versionados siguen en la historia;
# no se reescribe (decision del operador: parar la sangria, no reescribir historia).
data/backups/**/*.parquet filter=lfs diff=lfs merge=lfs -text
data/experiments/**/*.parquet filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Tesis RL (EXP-TESIS-RL-01, 2026-08-25): checkpoints PPO + VecNormalize (~37 MB,
# 42 ficheros de ~1,9 MB). Son la evidencia congelada del pre-registro
# (code_bundle_sha256), asi que se versionan, pero via LFS para no engordar el pack.
# =============================================================================
data/thesis/**/*.zip filter=lfs diff=lfs merge=lfs -text
data/thesis/**/*.pkl filter=lfs diff=lfs merge=lfs -text
